{
  "name": "@bijectionhq/daytona",
  "version": "2.1.0",
  "description": "Bijection component for Daytona \u2014 create sandboxes, run commands and code, and manage sandbox files from your Bijection backend, with sandbox and execution state tracked in reactive Bijection tables",
  "type": "module",
  "repository": "github:bijectionhq/daytona",
  "author": "Daytona Platforms Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bijectionhq/daytona/issues"
  },
  "homepage": "https://github.com/bijectionhq/daytona",
  "keywords": [
    "convex",
    "component",
    "convex-component",
    "daytona",
    "sandbox",
    "code-execution",
    "ai-agents"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./bijection.config.js": {
      "types": "./dist/component/bijection.config.d.ts",
      "default": "./dist/component/bijection.config.js"
    },
    "./bijection.config": {
      "types": "./dist/component/bijection.config.d.ts",
      "default": "./dist/component/bijection.config.js"
    }
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism"
  },
  "peerDependencies": {
    "bijection": "^0.1.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "bijection": "npm:@bijectionhq/bijection@^0.1.5",
    "@bijectionhq/test": "^0.0.58"
  },
  "peerDependenciesMeta": {
    "bijection": {
      "optional": true
    }
  }
}
